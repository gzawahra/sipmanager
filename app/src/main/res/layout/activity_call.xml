<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frame_layout_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center"
    android:paddingVertical="30dp"
    android:orientation="vertical"
    android:background="@color/colorBlack">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_text_view_phone_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.35"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_text_view_call_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5"/>

    <TextView
        android:id="@+id/communication_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/colorWhite"
        android:paddingHorizontal="20dp"
        android:paddingVertical="2dp"
        android:textStyle="bold"
        android:singleLine="true"
        android:background="@drawable/bg_green"
        android:text="@string/voip"
        android:textSize="28sp"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_view_phone_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/communication_type"
        app:layout_constraintBottom_toTopOf="@id/guideline_text_view_phone_number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="+44444444444444"
        android:textSize="28sp"
        android:textColor="@color/colorWhite"/>

    <TextView
        android:id="@+id/text_view_call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/text_view_phone_number"
        app:layout_constraintBottom_toTopOf="@id/guideline_text_view_call_duration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="00:00"
        android:textSize="28sp"
        android:visibility="invisible"
        android:textColor="@color/colorWhite"/>

    <FrameLayout
        android:id="@+id/frame_icon_call_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/guideline_text_view_call_duration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        android:background="@drawable/green_circle_background">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/call_white"
            android:padding="25dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>